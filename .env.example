# Copia este archivo a .env (en local) o pon estas variables en Railway.
BALLDONTLIE_API_KEY=
ODDS_API_KEY=
ANTHROPIC_API_KEY=
# Clave larga y aleatoria para /admin/* (publicar, liquidar, escanear).
ADMIN_TOKEN=
# Tu correo: con él ves todas las líneas y publicas tus picks desde la web.
ADMIN_EMAILS=
# Railway la crea sola al añadir Postgres. En local basta con SQLite.
DATABASE_URL=sqlite:///./propdeep.db
# 2026 = temporada 2026-27
NBA_SEASON=2026
ODDS_REGIONS=eu
MIN_EDGE=0.03
MODEL_WEIGHT=0.5
# Dominio(s) de la landing, separados por comas. "*" solo para pruebas.
CORS_ORIGINS=https://propdeep.pages.dev
# Dirección pública de la web (enlace de acceso por correo y vuelta de Stripe).
WEB_URL=https://propdeep.pages.dev
# Líneas por jornada con el análisis visible gratis.
FREE_LINES_PER_DAY=3
# Chat para suscriptores (necesita ANTHROPIC_API_KEY): mensajes por persona y día, y esfuerzo
# del modelo (low, medium, high). Más esfuerzo = respuestas más cuidadas, más lentas y más caras.
# Con el plan Pro activo (STRIPE_PRICE_PRO), este es el tope del Pro y el de los demás planes es
# CHAT_MESSAGES_PER_DAY_BASIC. Sin plan Pro, todos tienen CHAT_MESSAGES_PER_DAY.
CHAT_MESSAGES_PER_DAY=30
CHAT_MESSAGES_PER_DAY_BASIC=5
CHAT_EFFORT=medium
# Vacío = el mismo modelo que los informes. Un modelo más pequeño abarata cada mensaje.
CHAT_MODEL=
# Stripe (modo prueba primero: claves sk_test_ y precios price_ de prueba).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Plan Pro (25 €/mes, recurrente) y pase de 7 días (5 €, pago único). Vacíos = no se ofrecen.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PASS=
# Auditoría de tipsters: "true" para enseñarla en la web (antes, solo la ve el autor).
TIPSTERS_PUBLIC=
# Correo para el enlace de acceso. Sin SMTP, el enlace sale en el log (útil en local).
# Con Gmail: smtp.gmail.com, 587, la cuenta y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
