# Copia este archivo a .env (en local) o pon estas variables en Railway.
BALLDONTLIE_API_KEY=
ODDS_API_KEY=
ANTHROPIC_API_KEY=
# Clave larga y aleatoria para /admin/* (publicar, liquidar, escanear).
ADMIN_TOKEN=
# Railway la crea sola al añadir Postgres. En local basta con SQLite.
DATABASE_URL=sqlite:///./propdeep.db
# 2026 = temporada 2026-27
NBA_SEASON=2026
ODDS_REGIONS=eu
MIN_EDGE=0.03
MODEL_WEIGHT=0.5
# Dominio de la landing, separado por comas. "*" solo para pruebas.
CORS_ORIGINS=*
